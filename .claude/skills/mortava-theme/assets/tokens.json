{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Mortava",
    "inspiration": "cherre.com",
    "fidelity": "structure verified; hex/font values approximated — see SKILL.md 'Fidelity note'",
    "version": "0.1.0"
  },
  "color": {
    "ink": { "value": "#0B1023", "description": "Deep ink-navy: hero, footer, dark bands" },
    "inkSoft": { "value": "#151B36", "description": "Raised surfaces on dark" },
    "inkBorder": { "value": "#262D4F", "description": "Hairlines on dark" },
    "surface": { "value": "#FFFFFF" },
    "surfaceAlt": { "value": "#F5F6FA" },
    "accent": { "value": "#E8404A", "description": "Cherry red — CTAs, links, highlights only" },
    "accentStrong": { "value": "#C82F3D" },
    "accentTint": { "value": "#FDECEE" },
    "text": { "value": "#171C30" },
    "textMuted": { "value": "#5B6178" },
    "textInverse": { "value": "#F7F8FC" },
    "textInverseMuted": { "value": "#A7AEC8" },
    "border": { "value": "#E4E7F0" },
    "viz": {
      "1": { "value": "#E8404A" },
      "2": { "value": "#3D5AFE" },
      "3": { "value": "#14B8A6" },
      "4": { "value": "#F59E0B" },
      "5": { "value": "#8B5CF6" }
    }
  },
  "font": {
    "display": { "value": "Poppins, 'Avenir Next', 'Segoe UI', system-ui, sans-serif" },
    "body": { "value": "Inter, 'Helvetica Neue', system-ui, sans-serif" },
    "weightDisplay": { "value": 600 },
    "weightBody": { "value": 400 }
  },
  "fontSize": {
    "hero": { "value": "clamp(2.5rem, 5.5vw, 4.25rem)" },
    "h2": { "value": "clamp(1.75rem, 3.2vw, 2.5rem)" },
    "h3": { "value": "1.375rem" },
    "bodyLg": { "value": "1.125rem" },
    "body": { "value": "1.0625rem" },
    "small": { "value": "0.875rem" },
    "eyebrow": { "value": "0.8125rem" }
  },
  "radius": {
    "card": { "value": "16px" },
    "media": { "value": "12px" },
    "pill": { "value": "999px" }
  },
  "shadow": {
    "card": { "value": "0 1px 2px #0B102308, 0 8px 24px #0B10230F" },
    "float": { "value": "0 12px 40px #0B10231F" }
  },
  "space": {
    "section": { "value": "clamp(6rem, 10vw, 8rem)" },
    "sectionSm": { "value": "clamp(3.5rem, 6vw, 5rem)" },
    "container": { "value": "1200px" },
    "gutter": { "value": "clamp(1.25rem, 4vw, 2.5rem)" }
  },
  "motion": {
    "ease": { "value": "cubic-bezier(0.22, 1, 0.36, 1)" },
    "duration": { "value": "200ms" }
  }
}
